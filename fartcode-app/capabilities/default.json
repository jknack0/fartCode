{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capability set for the main window",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "shell:allow-open",
    "process:default",
    "os:default",
    "core:event:default",
    "core:event:allow-listen",
    "dialog:default"
  ]
}